{
  "mcpServers": {
    "pw-cida": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--output-dir",
        "${CLAUDE_PROJECT_DIR}/auditoria/.navegador/cida",
        "--viewport-size",
        "1366x768"
      ],
      "env": {
        "PLAYWRIGHT_MCP_HEADLESS": "${PRODTESTER_HEADLESS:-false}",
        "PLAYWRIGHT_MCP_SECRETS_FILE": "${PRODTESTER_SEGREDOS:-}",
        "PLAYWRIGHT_MCP_STORAGE_STATE": "${PRODTESTER_SESSAO:-}"
      }
    },
